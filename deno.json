{
  "tasks": {
    "hono": "deno run --watch --allow-net --allow-read --allow-env --allow-ffi ./hono/index.ts",
    "db:setup": "deno run --allow-env --allow-net ./db/setup.ts",
    "db:seed": "deno run -A ./db/seed.ts",
    "dev": "deno run --watch --allow-env --allow-read --allow-net main.ts",
    "test": "deno test --allow-env --allow-read --allow-net",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "@felix/bcrypt": "jsr:@felix/bcrypt@^1.0.8",
    "@std/assert": "jsr:@std/assert@^1.0.16",
    "@driving_adapters/": "./driving_adapters/",
    "@driven_adapters/": "./driven_adapters/",
    "@application/": "./application/",
    "hono": "jsr:@hono/hono@^4.11.0",
    "pg": "npm:pg@^8.16.3",
    "zod": "npm:zod@^4.2.1"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  }
}
